# dependencies
/node_modules

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example is the ONLY one that is committed
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors
.idea/
.vscode/*
!.vscode/extensions.json

# scaffolding leftovers
/scaffold-tmp

# badge-art generation scratch (F10) — only the chosen patches are committed
assets/badges/_candidates/

# browser-image-compression's worker bundle, copied from node_modules by
# scripts/copy-image-compression-worker.mjs on predev/prebuild (F04). A build artefact:
# committing it would let a stale copy survive a dependency bump.
/public/vendor/
