# dependencies
/node_modules

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example is the ONLY one that is committed
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors
.idea/
.vscode/*
!.vscode/extensions.json

# scaffolding leftovers
/scaffold-tmp

# badge-art generation scratch (F10) — only the chosen patches are committed
assets/badges/_candidates/
assets/records/_candidates/

# app-icon generation scratch — same rule. What IS committed is the chosen silhouette and the two
# composed masters beside it, so `tools/make_icon_assets.py` can rebuild every shipped PNG from
# what is in the repo without another paid image call.
assets/icon/_candidates/

# browser-image-compression's worker bundle, copied from node_modules by
# scripts/copy-image-compression-worker.mjs on predev/prebuild (F04). A build artefact:
# committing it would let a stale copy survive a dependency bump.
/public/vendor/

# Python bytecode from the tools/ scripts
__pycache__/
*.pyc

# F19 capture harness scratch. The manifest names a throwaway demo user and the kept .webm files
# are recording intermediates — what IS committed is docs/media/, the build product.
scripts/capture/.manifest.json
scripts/capture/*.webm

# git worktrees for isolated feature work
.worktrees

# The Vercel-Pro cancellation reminder: a SessionStart hook that checks billing.plan
# against the Vercel API and DELETES ITSELF once the team is back on Hobby. Machine-local
# state like .claude/settings.local.json, and untracked for that reason: a tracked file
# that removes itself would leave a dirty worktree on somebody else's clone. The reasoning
# is preserved in the commit that introduced it.
.claude/vercel-cancel-reminder.sh
.claude/.vercel-cancel-done
