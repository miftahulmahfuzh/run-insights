{
  "name": "run-insights",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/copy-image-compression-worker.mjs",
    "build": "next build",
    "prebuild": "node scripts/copy-image-compression-worker.mjs",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "VITEST_INTEGRATION=1 vitest run tests/integration",
    "test:live": "LLM_LIVE_TEST=1 vitest run --dir . --testNamePattern=live",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:smoke": "node --env-file=.env.local scripts/db-smoke.mjs",
    "blob:reap": "node --env-file=.env.local scripts/blob-reap.mjs",
    "badges:backfill-runs": "node --env-file=.env.local scripts/backfill-badge-run-ids.mjs",
    "capture:seed": "node --env-file=.env.local scripts/capture/seed-demo.mjs",
    "capture:purge": "node --env-file=.env.local scripts/capture/seed-demo.mjs --purge",
    "capture:status": "node --env-file=.env.local scripts/capture/seed-demo.mjs --status",
    "capture:shoot": "node --env-file=.env.local scripts/capture/shoot.mjs",
    "ci:openrouter-guard": "node scripts/check-openrouter-boundary.mjs",
    "badges:check": "node scripts/check-badge-art.mjs",
    "ci:data-layer-guard": "node scripts/check-data-layer-invariants.mjs",
    "ci:client-secret-guard": "node scripts/check-client-secret-boundary.mjs",
    "ci:f08-guard": "node scripts/check-f08-boundaries.mjs",
    "ci:llm-payload-guard": "node scripts/check-llm-payload-boundary.mjs",
    "ci:f11-guard": "node scripts/check-f11-share-boundaries.mjs",
    "og:default": "node scripts/gen-og-default.mjs",
    "icon:assets": "python3 tools/make_icon_assets.py",
    "test:live:vision": "LLM_LIVE_TEST=1 vitest run tests/live/vision.live.test.ts",
    "test:live:narrate": "LLM_LIVE_TEST=1 vitest run tests/live/narrate.live.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.117.1",
    "@auth/drizzle-adapter": "1.11.3",
    "@neondatabase/serverless": "1.1.0",
    "@vercel/blob": "2.8.0",
    "browser-image-compression": "2.0.2",
    "drizzle-orm": "0.45.2",
    "nanoid": "5.1.16",
    "next": "16.3.1",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "10.1.8",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.2"
  }
}
