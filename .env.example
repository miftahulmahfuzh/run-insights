# ---------------------------------------------------------------------------
# Run Insights — runins.site
# Every variable here is SERVER-ONLY. None may ever be prefixed NEXT_PUBLIC_.
# THIS file is the committed template. Copy it to .env.local and fill in the
# blanks — .env.local is git-ignored and must stay so. Never paste a real key here.
# ---------------------------------------------------------------------------

# --- Auth.js v5 (F02) -------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Fill these from Google Cloud Console — see docs/google-auth-setup.md
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# PRODUCTION ONLY. Leave EMPTY locally and on Vercel preview — Auth.js infers
# the origin from the request there, and setting it breaks preview sign-in.
AUTH_URL=

# --- LLM: vision (F04) ------------------------------------------------------
# glm-4.6v on the CODING endpoint. NOT the Anthropic base URL — that one accepts
# images, returns 200, and silently discards them. See IMPLEMENTATION_PLAN §1.1.
# NOTE: no separate key. Vision reuses LLM_API_KEY below — one z.ai coding-plan
# subscription serves both endpoints. Verified live, 2026-08-20. See R-40.
LLM_VISION_BASE_URL=https://api.z.ai/api/coding/paas/v4
LLM_VISION_MODEL=glm-4.6v

# --- LLM: narrative (F07) ---------------------------------------------------
# No trailing slash, no /v1 suffix — the SDK appends /v1/messages itself.
LLM_API_KEY=
LLM_BASE_URL=https://api.z.ai/api/anthropic
LLM_MODEL=glm-5.3

# --- Neon Postgres (F03) ----------------------------------------------------
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Vercel Blob (F04) ------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# --- Cron (F07) -------------------------------------------------------------
CRON_SECRET=

# --- Badge art (F10) — BUILD-TIME ONLY --------------------------------------
# Read by tools/gen_badge_art.py and by NOTHING in app/ or lib/.
# Copy the value from /home/miftah/daily-words/.env.local
OPENROUTER_API_KEY=
